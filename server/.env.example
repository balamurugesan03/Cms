# ---- Server ----
PORT=5000
NODE_ENV=development
# Sub-path the app is served from. "/cms" for https://unizova.com/cms, empty for domain root / local dev
BASE_PATH=

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/buildpro

# ---- Auth ----  generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES=7d

# ---- CORS ----
CLIENT_URL=http://localhost:5173
